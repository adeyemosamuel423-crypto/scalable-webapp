server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # ============================================================
    # FRONTEND
    # ============================================================
    location / {
        try_files $uri $uri/ /index.html;
    }

    # ============================================================
    # BACKEND API
    # ============================================================
    location /api/ {

        proxy_pass https://streamhive-api.purplesky-dac4ff01.spaincentral.azurecontainerapps.io/api/;

        # --------------------------------------------------------
        # HTTPS / TLS configuration
        # --------------------------------------------------------
        proxy_ssl_server_name on;
        proxy_ssl_name streamhive-api.purplesky-dac4ff01.spaincentral.azurecontainerapps.io;

        # --------------------------------------------------------
        # HTTP proxy configuration
        # --------------------------------------------------------
        proxy_http_version 1.1;

        # IMPORTANT:
        # Send the backend hostname, NOT the frontend hostname.
        proxy_set_header Host streamhive-api.purplesky-dac4ff01.spaincentral.azurecontainerapps.io;

        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        # --------------------------------------------------------
        # Request / response settings
        # --------------------------------------------------------
        proxy_buffering off;

        client_max_body_size 500M;

        proxy_connect_timeout 60s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }

    # ============================================================
    # GZIP
    # ============================================================
    gzip on;

    gzip_types
        text/css
        application/javascript
        application/json
        text/plain
        application/xml
        application/xml+rss
        text/javascript;
}