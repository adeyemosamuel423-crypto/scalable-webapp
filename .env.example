# ============================================================
# StreamHive Environment Configuration
# ============================================================
#
# Copy this file to:
#
#     .env
#
# for local Docker development.
#
# IMPORTANT:
# Do NOT put real Azure passwords, connection strings, or
# production secrets in this file or commit them to GitHub.
#
# ============================================================


# ============================================================
# APPLICATION
# ============================================================

NODE_ENV=development

PORT=4000

HOST=0.0.0.0


# ============================================================
# POSTGRESQL
# ============================================================
#
# Local Docker:
#     PGHOST=postgres
#
# Azure:
#     PGHOST=<your-azure-postgresql-host>
#
# ============================================================

PGHOST=postgres

PGPORT=5432

PGUSER=streamhive

PGPASSWORD=streamhive_pw

PGDATABASE=streamhive

# Local Docker PostgreSQL does not require SSL.
# Azure PostgreSQL:
#     PGSSL=true

PGSSL=false

# Connection pool configuration

PG_POOL_MAX=20

PG_IDLE_TIMEOUT=30000

PG_CONNECTION_TIMEOUT=10000


# ============================================================
# REDIS
# ============================================================
#
# Local Docker:
#     REDIS_HOST=redis
#
# Azure:
#     REDIS_HOST=streamhive-redis
#
# ============================================================

REDIS_HOST=redis

REDIS_PORT=6379

# Optional Redis password.
# Leave empty when using the local Redis container.

REDIS_PASSWORD=

REDIS_DEFAULT_TTL=30


# ============================================================
# OBJECT STORAGE
# ============================================================
#
# Local Docker:
#     STORAGE_PROVIDER=minio
#
# Azure:
#     STORAGE_PROVIDER=azure
#
# ============================================================

STORAGE_PROVIDER=minio


# ============================================================
# MINIO - LOCAL DEVELOPMENT
# ============================================================

MINIO_ENDPOINT=minio

MINIO_PORT=9000

MINIO_USE_SSL=false

MINIO_ACCESS_KEY=streamhive

MINIO_SECRET_KEY=streamhive_secret

MINIO_BUCKET=streamhive-videos


# ============================================================
# AZURE BLOB STORAGE
# ============================================================
#
# Leave these empty for local development.
#
# In Azure, provide these through Azure Container Apps
# environment variables / secrets.
#
# DO NOT commit the real connection string to GitHub.
#
# ============================================================

AZURE_STORAGE_CONNECTION_STRING=

AZURE_STORAGE_CONTAINER=streamhive-videos


# ============================================================
# AUTHENTICATION
# ============================================================
#
# Replace this value with a long random secret before any
# production deployment.
#
# ============================================================

JWT_SECRET=change_this_to_a_long_random_string


# ============================================================
# DEMO CREATOR
# ============================================================
#
# A demo creator account is automatically created when the
# backend starts for the first time.
#
# ============================================================

SEED_CREATOR_EMAIL=creator@streamhive.local

SEED_CREATOR_PASSWORD=CreatorPass123!